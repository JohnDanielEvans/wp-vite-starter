{
  "name": "wp-vite-starter",
  "version": "1.0.0",
  "description": "WordPress starter theme with a wp-env + Vite local development harness, image optimization, cache-busted assets, and rsync-based CI deployment.",
  "scripts": {
    "dev": "cross-env NODE_ENV=local vite --host",
    "build:dev": "cross-env NODE_ENV=local vite build && npm run press:images",
    "build:stg": "cross-env NODE_ENV=staging vite build && npm run press:images",
    "build": "cross-env NODE_ENV=production vite build && npm run press:images",
    "preview": "vite preview",
    "press:images": "node convert.images.mjs",
    "db:import": "gzip -dfk sql/wpenv.sql.gz && npm run wp:env run cli wp db import sql/wpenv.sql && rm -f sql/wpenv.sql",
    "db:export": "npm run wp:env run cli wp db export sql/wpenv.sql; gzip -f sql/wpenv.sql",
    "wp:env": "wp-env",
    "wp:start": "npm run wp:env start",
    "wp:restart": "npm run wp:env start --update && npm run wp:env run cli 'wp rewrite flush --hard'",
    "wp:setup": "npm run wp:start && npm run wp:env run cli 'wp rewrite flush --hard'",
    "wp:destroy": "npm run wp:env destroy",
    "lint:check": "npm run lint:html && npm run lint:style && npm run lint:es",
    "lint:html": "markuplint 'src/**/*.{html,php}'",
    "lint:style": "stylelint 'src/assets/**/*.{css,scss}'",
    "lint:es": "eslint 'src/assets/**/*.js'",
    "lint:fix": "markuplint 'src/**/*.{html,php}' && stylelint --fix 'src/assets/**/*.{css,scss}' && eslint --fix 'src/assets/**/*.js'",
    "format": "prettier --write 'src/**/*.{html,css,scss,js,json,php}'",
    "prepare": "husky",
    "deploy": "bash scripts/build-and-zip-theme.sh",
    "deploy:clean": "rm -rf deploy *.zip",
    "generate-version": "node scripts/generate-version.mjs",
    "copy-theme": "bash scripts/copy-theme.sh",
    "build:prod": "vite build && npm run generate-version && npm run press:images && npm run copy-theme"
  },
  "lint-staged": {
    "*.{html,php}": "markuplint",
    "*.js": "eslint --fix",
    "*.{css,scss}": "stylelint --fix --allow-empty-input",
    "*.{html,css,scss,js,json,php}": "prettier --write"
  },
  "author": "John Evans",
  "license": "MIT",
  "private": false,
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@eslint/js": "^9.22.0",
    "@markuplint/php-parser": "^4.6.18",
    "@prettier/plugin-php": "^0.22.4",
    "@wordpress/env": "^10.20.0",
    "autoprefixer": "^10.4.21",
    "commander": "^13.1.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "fs-extra": "^11.3.0",
    "glob": "^11.0.1",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "markuplint": "^4.11.8",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "sass": "^1.86.0",
    "sharp": "^0.33.5",
    "stylelint": "^16.16.0",
    "stylelint-config-recess-order": "^6.0.0",
    "stylelint-config-standard-scss": "^14.0.0",
    "stylelint-prettier": "^5.0.3",
    "svgo": "^3.3.2",
    "vite": "^6.2.2",
    "vite-plugin-browser-sync": "^4.0.0",
    "vite-plugin-live-reload": "^3.0.4",
    "vite-plugin-static-copy": "^2.3.0",
    "vite-plugin-svg-sprite-component": "^1.0.10"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "animate.css": "^4.1.1",
    "aos": "^2.3.4",
    "bootstrap": "^5.3.3",
    "gsap": "^3.12.7",
    "jquery": "^3.7.1",
    "keen-slider": "^6.8.6",
    "rellax": "^1.12.1"
  }
}
