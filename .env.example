# Copy to .env to run this project on different ports — useful when you have
# more than one of these checked out and the defaults collide.
#
#   cp .env.example .env
#
# .env is gitignored. Real environment variables win over this file, so a
# one-off run needs no file at all:
#
#   WP_PORT=8100 VITE_PORT=3130 npm start

# WordPress (wp-env). Default 8000.
WP_PORT=8000

# Vite dev server. Default 3030.
VITE_PORT=3030

# BrowserSync proxy. Defaults to VITE_PORT + 1, so it usually looks after
# itself; set it only if that lands on something you already use.
# BROWSERSYNC_PORT=3031
