
{
  "css.validate": false, // Disable VS Code's built-in CSS validation (stylelint handles it)
	"scss.validate": false, // Disable VS Code's built-in SCSS validation (stylelint handles it)
  "stylelint.validate": ["css", "scss"], // Let stylelint validate these languages
  "editor.formatOnSave": true, // Format on save
  "editor.defaultFormatter": "esbenp.prettier-vscode", // Use Prettier as the default formatter
  "prettier.documentSelectors": [
    "**/*.{js,jsx,ts,tsx,vue,html,css,scss,less,json,md,mdx,graphql,yaml,yml,php}"
  ],


  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode" // Pin Prettier for HTML explicitly
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode" // Pin Prettier for CSS explicitly
  },
  "[scss]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode" // Pin Prettier for SCSS explicitly
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode" // Pin Prettier for JavaScript explicitly
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode" // Pin Prettier for TypeScript explicitly
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode" // Pin Prettier for JSON explicitly
  },
  "[php]": {
      "editor.defaultFormatter": "bmewburn.vscode-intelephense-client"
  },
  "editor.codeActionsOnSave": {
    "source.fixAll.stylelint": "explicit", // Apply stylelint autofixes on save
    "source.fixAll.eslint": "explicit" // Apply ESLint autofixes on save
  },
}