{
  // stylelint handles CSS and SCSS; VS Code's built-in validation only
  // duplicates it and disagrees about SCSS syntax.
  "css.validate": false,
  "scss.validate": false,
  "stylelint.validate": ["css", "scss"],

  // Prettier formats everything except PHP, which Intelephense handles.
  // Per-language overrides are unnecessary while this default is set.
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "prettier.documentSelectors": [
    "**/*.{js,jsx,ts,tsx,vue,html,css,scss,less,json,md,mdx,graphql,yaml,yml,php}"
  ],
  "[php]": {
    "editor.defaultFormatter": "bmewburn.vscode-intelephense-client"
  },

  "editor.codeActionsOnSave": {
    "source.fixAll.stylelint": "explicit",
    "source.fixAll.eslint": "explicit"
  }
}
