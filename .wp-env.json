{
  "core": "https://wordpress.org/latest.zip",
  "phpVersion": "8.1",
  "plugins": [],
  "themes": ["./src/"],
  "port": 8000,
  "env": {
    "tests": {
      "port": 8001
    }
  },
  "mappings": {
    "wp-content/plugins": "./plugins",
    "sql": "./sql",
    "wp-content/uploads": "./uploads"
